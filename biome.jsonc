{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/routeTree.gen.ts",
      "!**/drizzle",
      "!packages/linux/**/*.css",
      "!**/.output",
      "!.agents",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "domains": {
      "drizzle": "recommended",
      "project": "recommended",
      // "react": "recommended",
      "turborepo": "recommended",
      "types": "recommended"
    },
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error"
      },
      "complexity": {
        "noStaticOnlyClass": "warn",
        "useLiteralKeys": "off"
      },
      "nursery": {
        "useSortedClasses": "warn"
      },
      "style": {
        "noParameterAssign": "error",
        "noNonNullAssertion": "off",
        "useConst": "error",
        "noInferrableTypes": "error",
        "useNumberNamespace": "error",
        "noUselessElse": "error"
      },
      "suspicious": {
        "noConsole": "warn",
        "useAwait": "warn",
        "noDuplicateElseIf": "warn",
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "arrowParentheses": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
